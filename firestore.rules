rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(workspace) {
      return get(/databases/$(database)/documents/workspaces/$(workspace)/members/$(request.auth.uid));
    }
    function member(workspace) {
      return signedIn() && membership(workspace).data.active == true
        && membership(workspace).data.role in ['المدير','نجاة','سلمى','حسن','لقمان'];
    }
    function admin(workspace) { return member(workspace) && membership(workspace).data.role == 'المدير'; }
    function permitted(workspace, kind) {
      let role = membership(workspace).data.role;
      return (role == 'نجاة' && kind in ['product','purchase','produce','produceFromRecipe','transfer','receive','recipe'])
        || (role == 'سلمى' && kind in ['receive','sale','deliver','cancelOrder'])
        || (role == 'حسن' && kind == 'campaign');
    }
    match /workspaces/{workspace}/members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin(workspace));
      allow list: if admin(workspace);
      allow create, update: if admin(workspace)
        && request.resource.data.keys().hasOnly(['role','active'])
        && request.resource.data.role in ['المدير','نجاة','سلمى','حسن','لقمان']
        && request.resource.data.active is bool
        && (uid != request.auth.uid || (request.resource.data.role == 'المدير' && request.resource.data.active == true));
      allow delete: if false;
    }
    match /workspaces/{workspace}/state/{visibility} {
      allow read: if (visibility == 'public' && member(workspace)) || (visibility == 'private' && admin(workspace));
      allow create, update: if admin(workspace) && visibility in ['public','private']
        && request.resource.data.keys().hasOnly(['json','revision','updated'])
        && request.resource.data.json is string && request.resource.data.json.size() <= 750000
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.updated == request.time
        && getAfter(/databases/$(database)/documents/workspaces/$(workspace)/state/public).data.revision
          == getAfter(/databases/$(database)/documents/workspaces/$(workspace)/state/private).data.revision;
      allow delete: if false;
    }
    match /workspaces/{workspace}/commands/{command} {
      allow get: if member(workspace) && (admin(workspace)
        || !exists(/databases/$(database)/documents/workspaces/$(workspace)/commands/$(command))
        || resource.data.uid == request.auth.uid);
      allow list: if member(workspace) && (admin(workspace) || resource.data.uid == request.auth.uid);
      allow create: if member(workspace) && permitted(workspace,request.resource.data.kind)
        && request.resource.data.keys().hasOnly(['uid','kind','arguments','status','created'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.arguments is map && request.resource.data.created == request.time;
      allow update: if admin(workspace) && resource.data.status == 'pending'
        && request.resource.data.status in ['applied','rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','error','processed','processedBy'])
        && request.resource.data.processed == request.time && request.resource.data.processedBy == request.auth.uid;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
